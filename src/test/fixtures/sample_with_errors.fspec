// Fault specification with intentional errors for linter testing
spec sampleWithErrors;

// Error: grouped const syntax (const-group-syntax)
const (
    MAXCAPACITY = 100;
    RATE = 10;
)

def tokenBucket = stock{
    tokens: unknown(),
    capacity: 100,
};

// Error: scalar value in flow property (flow-scalar-property — causes compiler panic)
def badFlow = flow{
    bucket: new tokenBucket,
    rate: 3,
    active: false,
};

// Error: directional operator with arithmetic RHS (directional-operator-expression-rhs)
def drainFlow = flow{
    bucket: new tokenBucket,
    drain: func{
        bucket.tokens -> bucket.tokens - 1;
    },
};

// Error: identifier with underscore (invalid-identifier)
def my_stock = stock{
    level: unknown(),
};

// Error: when/then with temporal qualifier (when-then-temporal)
assert when tokenBucket.tokens < 0 then tokenBucket.capacity >= 0 always;

// Error: unfalsifiable assertion (unfalsifiable-assertion)
assume tokenBucket.tokens >= 0;
assert tokenBucket.tokens >= 0 always;

run init {
    d = new drainFlow;
} {
    d.drain;
}
